{
  "rules": {
    ".read": false,
    ".write": false,

    "roles": {
      ".read": "root.child('roles').child(auth.uid).child('role').val() === 'admin'",

      "$uid": {
        ".read": "auth != null && auth.uid === $uid",

        ".write": "root.child('roles').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['user', 'role'])",

        "user":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "role":       { ".validate": "newData.val() === 'admin' || newData.val() === 'vendedor'" },
        "vendedor":   { ".validate": "newData.isString() && newData.val().length <= 60" },
        "cronograma": { ".validate": "newData.val() === 'cc' || newData.val() === 'lp'" },

        "passChanged": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        },

        "$otro": { ".validate": false }
      }
    },

    "cronogramas": {
      "$id": {
        ".read": "auth != null",
        ".write": "root.child('roles').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "$id === 'cc' || $id === 'lp'",

        "cronograma": {
          "$fecha": {
            ".validate": "$fecha.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            "manana":  { ".validate": "newData.isString() || newData.val() === null" },
            "tarde":   { ".validate": "newData.isString() || newData.val() === null" },
            "holiday": { ".validate": "newData.isBoolean()" },
            "closed":  { ".validate": "newData.isBoolean()" },
            "$otro":   { ".validate": false }
          }
        },

        "feriados": {
          "$fecha": {
            ".validate": "$fecha.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isString() && newData.val().length <= 120"
          }
        },

        "historial": {
          "$i": { ".validate": "newData.hasChildren(['ts', 'regla', 'estado'])" }
        },

        "revisiones": {
          "$fecha": { ".validate": "newData.isString()" }
        },

        "$otro": { ".validate": false }
      }
    },

    "users": {
      ".read": false,
      ".write": false
    }
  }
}
